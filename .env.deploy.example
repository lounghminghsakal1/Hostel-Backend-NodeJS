# Copy this file to .env.deploy (git-ignored) and fill it in. Used by `npm run deploy`.
# Your SSH key stays on your PC: only its path goes here.

# EC2 public IP or DNS name (or a Host alias from ~/.ssh/config)
EC2_HOST=172.31.35.155
# Login user: ubuntu on Ubuntu, ec2-user on Amazon Linux
EC2_USER=ubuntu
# Path to the .pem key you SSH with, e.g. C:/Users/you/keys/hostel-ec2.pem (leave empty if ~/.ssh/config has it)
EC2_SSH_KEY=

# Optional (these are the defaults)
APP_DIR=/home/ubuntu/Hostel-Backend-NodeJS
PM2_APP=hostel-backend
DEPLOY_BRANCH=main
APP_PORT=2471
