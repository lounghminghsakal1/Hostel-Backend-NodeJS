// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleNameEnum {
  STUDENT
  HOSTEL_ADMIN
}

model Role {
  id       Int          @id @default(autoincrement())
  roleName RoleNameEnum @unique

  users User[]
}

enum UserStatusEnum {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id                 Int            @id @default(autoincrement())
  email              String         @unique
  passwordHash       String
  status             UserStatusEnum @default(ACTIVE)
  mustChangePassword Boolean        @default(false)

  roleId Int
  collegeId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile     StudentProfile?    
  hostelAdminProfile HostelAdminProfile? 

  role       Role    @relation(fields: [roleId], references: [id])
  college    College @relation(fields: [collegeId], references: [id])
}

model College {
  id                Int    @id @default(autoincrement())
  collegeName       String @unique
  location          String
  contactPersonName String
  contactNumber     String

  hostels     Hostel[]
  departments Department[]
  users User[]
  students StudentProfile[]
  hostelAdmins HostelAdminProfile[]
}

model Hostel {
  id                Int    @id @default(autoincrement())
  hostelName        String
  location          String
  latitude          Float
  longitude         Float
  contactPersonName String
  contactNumber     String
  attendanceMarkingStartTime String? @default("20:30")
  attendanceMarkingEndTime   String? @default("22:00")
  attendanceRadius  Float    @default(800) 

  collegeId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hostelAdmins HostelAdminProfile[]
  college      College              @relation(fields: [collegeId], references: [id])
  rooms        Room[]
  students StudentProfile[]

  @@unique([collegeId, hostelName])
}

model Department {
  id                Int    @id @default(autoincrement())
  departmentName    String
  hodName           String
  contactPersonName String
  contactNumber     String

  collegeId Int

  students StudentProfile[]

  college College @relation(fields: [collegeId], references: [id])

  @@unique([collegeId, departmentName])
}

model Room {
  id         Int    @id @default(autoincrement())
  roomNumber String
  capacity   Int

  hostelId        Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hostel          Hostel           @relation(fields: [hostelId], references: [id])
  studentProfiles StudentProfile[]

  @@unique([hostelId, roomNumber])
}

model StudentProfile {
  id                 Int  @id   @default(autoincrement())
  studentName        String
  contactNumber      String @unique
  parentMobileNumber String
  studentImageUrl    String?

  userId       Int  @unique
  departmentId Int
  roomId       Int?
  collegeId Int
  hostelId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  room       Room?      @relation(fields: [roomId], references: [id])
  college College @relation(fields: [collegeId], references: [id])
  hostel Hostel @relation(fields: [hostelId], references: [id])
  leaveApplications LeaveApplication[]
  attendanceRecords AttendanceRecord[]

}

model HostelAdminProfile {
  id              Int   @id @default(autoincrement())
  hostelAdminName String
  contactNumber   String @unique

  userId   Int @unique
  hostelId Int
  collegeId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  hostel Hostel @relation(fields: [hostelId], references: [id])
  college College @relation(fields: [collegeId], references: [id])
}

enum LeaveApplicationStatusEnum {
  WAITING_FOR_APPROVAL
  APPROVED
  REJECTED
  CANCELLED //cancelled by student
}

model LeaveApplication {
  id Int @id @default(autoincrement())
  leaveReason String 
  fromDate DateTime 
  toDate DateTime
  status LeaveApplicationStatusEnum @default(WAITING_FOR_APPROVAL)
  rejectionReason String?

  studentId Int 

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  reviewedAt DateTime?

  student StudentProfile @relation(fields: [studentId], references: [id])
}

model AttendanceRecord {
  id                    Int         @id @default(autoincrement())
  attendanceDate        DateTime    @db.Date
  reportedTime          DateTime    @default(now())
  capturedImageUrl      String
  faceMatchingPercentage    Float     
  latitude              Float
  longitude             Float
  isLocatedWithinHostelRadius Boolean  @default(false)
  locationDeviationFromhostel     Float?
  
  studentId Int

  student StudentProfile @relation(fields: [studentId], references: [id])

  @@unique([studentId, attendanceDate])
}
